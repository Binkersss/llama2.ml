+(* xout.(0..d-1) <- W[off ..] (d x n, row-major) * x.(0..n-1) *)
+let matmul xout x w off n d =
+  for i = 0 to d - 1 do
+    let acc = ref 0.0 in
+    let base = off + i * n in
+    for j = 0 to n - 1 do
+      acc := !acc +. w.(base + j) *. x.(j)
+    done;
+    xout.(i) <- !acc
+  done
 
